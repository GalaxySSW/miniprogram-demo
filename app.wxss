/**
 * 判判 UI Design System v2
 * Figma handoff: warm paper surface, cocoa ink, restrained status colors.
 * This file keeps the legacy classes used by existing pages and adds the
 * shared pp-* vocabulary used by the new public components.
 */
page {
  /* 移动端运行时 Token：来自 Figma UI Design System / v2。 */
  --panpan-bg-page: #FAF7F2;
  --panpan-surface-paper: #FFFDF9;
  --panpan-brand-cocoa: #3B2919;
  --panpan-text-primary: #1A1918;
  --panpan-action-primary: #3B2919;
  --panpan-accent-peach: #FFD9C7;
  --panpan-status-honey: #B0793F;
  --panpan-status-sage: #7E9B72;
  --panpan-status-danger: #C9573F;
  --panpan-border-soft: #E1DACE;
  --panpan-text-secondary: #6E685F;
  --panpan-text-tertiary: #9C958A;
  --panpan-radius-card: 32rpx;
  --panpan-radius-control: 16rpx;
  --panpan-radius-pill: 999rpx;
  --panpan-space-page: 24rpx;
  --panpan-space-section: 32rpx;
  --panpan-space-control: 16rpx;
  --panpan-space-xxs: 8rpx;
  --panpan-space-xs: 12rpx;
  --panpan-space-sm: 16rpx;
  --panpan-space-md: 24rpx;
  --panpan-space-lg: 32rpx;
  --panpan-space-xl: 48rpx;
  --panpan-typography-display-size: 64rpx;
  --panpan-typography-display-line: 80rpx;
  --panpan-typography-heading-size: 48rpx;
  --panpan-typography-heading-line: 64rpx;
  --panpan-typography-body-size: 32rpx;
  --panpan-typography-body-line: 52rpx;
  --panpan-typography-label-size: 26rpx;
  --panpan-typography-label-line: 40rpx;
  --panpan-typography-caption-size: 22rpx;
  --panpan-typography-caption-line: 32rpx;
  background: var(--panpan-bg-page);
  color: var(--panpan-text-primary);
  font-family: 'Noto Sans SC', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: var(--panpan-typography-body-size);
  line-height: var(--panpan-typography-body-line);
}

.wrap { padding: var(--panpan-space-page) 48rpx 60rpx; }

/* 排印 */
.kicker { font-size: var(--panpan-typography-label-size); line-height: var(--panpan-typography-label-line); letter-spacing: 0.12em; color: var(--panpan-brand-cocoa); }
.h1 { font-size: var(--panpan-typography-display-size); font-weight: 600; line-height: var(--panpan-typography-display-line); letter-spacing: 0; }
.h2 { font-size: var(--panpan-typography-heading-size); font-weight: 600; line-height: var(--panpan-typography-heading-line); }
.sub { font-size: var(--panpan-typography-body-size); color: var(--panpan-text-secondary); line-height: var(--panpan-typography-body-line); }
.faint { font-size: var(--panpan-typography-caption-size); color: var(--panpan-text-tertiary); line-height: var(--panpan-typography-caption-line); }
.center { text-align: center; }

/* Figma typography aliases: 1px = 2rpx for the 375px mini-program viewport. */
.pp-display { font-size: 64rpx; line-height: 80rpx; font-weight: 600; }
.pp-heading { font-size: 48rpx; line-height: 64rpx; font-weight: 600; }
.pp-body { font-size: 32rpx; line-height: 52rpx; font-weight: 400; }
.pp-label { font-size: 26rpx; line-height: 40rpx; font-weight: 500; }
.pp-caption { font-size: 22rpx; line-height: 32rpx; font-weight: 400; }
.pp-muted { color: var(--panpan-text-secondary); }
.pp-tertiary { color: var(--panpan-text-tertiary); }

/* 卡片：白底 1px 描边，无投影 */
.card {
  background: var(--panpan-surface-paper);
  border: 1rpx solid var(--panpan-border-soft);
  border-radius: var(--panpan-radius-card);
  padding: 40rpx;
  box-sizing: border-box;
}
.hairline { border-top: 1rpx solid var(--panpan-border-soft); }

/* 胶囊按钮 */
.btn {
  min-height: 96rpx;
  height: 96rpx;
  border-radius: var(--panpan-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 52rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}
.btn-primary { background: var(--panpan-action-primary); color: var(--panpan-bg-page); }
.btn-ghost { background: var(--panpan-bg-page); border: 1rpx solid var(--panpan-border-soft); color: var(--panpan-text-primary); }
.btn-disabled { background: var(--panpan-border-soft); color: var(--panpan-text-tertiary); }

/* 原生 button 复用 .btn 时重置默认样式 */
button.btn { padding: 0; margin: 0; line-height: inherit; }
button.btn::after { border: none; }

/* chips（情绪标签等，选中填蜜色） */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 32rpx;
  border-radius: var(--panpan-radius-pill);
  border: 1rpx solid var(--panpan-border-soft);
  background: var(--panpan-bg-page);
  font-size: 24rpx;
  color: var(--panpan-text-secondary);
  margin: 0 16rpx 16rpx 0;
}
.chip-on { background: var(--panpan-status-honey); border-color: var(--panpan-status-honey); color: var(--panpan-text-primary); }

/* 状态胶囊 */
.pill {
  display: inline-flex;
  padding: 4rpx 20rpx;
  border-radius: var(--panpan-radius-pill);
  font-size: 20rpx;
  font-weight: 500;
}
.pill-honey { background: rgba(221, 187, 122, 0.2); color: var(--panpan-brand-cocoa); }
.pill-matcha { background: rgba(168, 184, 154, 0.22); color: #627255; }

/* 印章（陶土红，落章动画：0.7s 落下，旋转 -12°） */
.seal {
  width: 150rpx;
  height: 150rpx;
  border: 4rpx solid var(--panpan-status-danger);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--panpan-status-danger);
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  line-height: 1.4;
  transform: rotate(-12deg);
  background: rgba(255, 249, 241, 0.92);
}
.seal-drop { animation: sealDrop 0.7s cubic-bezier(0.2, 0.9, 0.3, 1) both; }
@keyframes sealDrop {
  0% { transform: rotate(-12deg) scale(2.2); opacity: 0; }
  100% { transform: rotate(-12deg) scale(1); opacity: 1; }
}

/* 输入 */
.field {
  background: var(--panpan-bg-page);
  border: 1rpx solid var(--panpan-border-soft);
  border-radius: var(--panpan-radius-control);
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  line-height: 52rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}
.field-ph { color: var(--panpan-text-tertiary); }

/* 通用间距 */
.mt8 { margin-top: 8rpx; } .mt16 { margin-top: 16rpx; } .mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; } .mt48 { margin-top: 48rpx; } .mt64 { margin-top: 64rpx; }
.gap { height: 24rpx; }
.grow { flex-grow: 1; }
.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }

/* Public component host helpers. These are intentionally additive so the
 * existing page classes remain valid during incremental page migration. */
.pp-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--panpan-bg-page);
  color: var(--panpan-text-primary);
}
.pp-surface {
  background: var(--panpan-surface-paper);
  border: 1rpx solid var(--panpan-border-soft);
  border-radius: var(--panpan-radius-card);
}
.pp-action-primary { background: var(--panpan-action-primary); color: var(--panpan-bg-page); }
.pp-action-secondary { background: var(--panpan-bg-page); color: var(--panpan-text-primary); border: 1rpx solid var(--panpan-border-soft); }
.pp-safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

/* 判决书分段揭晓：一段一段浮上来，让判决有揭晓感而不是一次性铺开 */
.reveal {
  opacity: 0;
  animation: rise 0.55s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
}
@keyframes rise {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 猫呼吸（开庭页等） */
.breathe { animation: breathe 4s ease-in-out infinite; }
@keyframes breathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(8rpx); }
}

/* 石子上浮 */
.float-up { animation: floatUp 0.3s ease-out both; }
@keyframes floatUp {
  0% { transform: translateY(24rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}


/* 判官小猫脸头像（原为自定义组件，内联进全局避免依赖分析误删） */
/* 64rpx 见方的小猫脸，耳朵略微探出顶部（右侧是文字，不会遮挡） */
.cf-face {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  transform-origin: 50% 90%;
}
.cf-face.cf-tilt { animation: cfTilt 2.6s ease-in-out infinite alternate; }
@keyframes cf-tilt {
  from { transform: rotate(-4deg); }
  to   { transform: rotate(4deg); }
}

.cf-head {
  position: absolute;
  inset: 0;
  border: 2rpx solid #1A1918;
  border-radius: 50%;
  background: #FFFDF9;
}

/* 耳朵：两个小三角，贴着圆的上沿 */
.cf-ear {
  position: absolute;
  top: -8rpx;
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-bottom: 14rpx solid #1A1918;
}
.cf-ear-l { left: 8rpx; transform: rotate(-16deg); }
.cf-ear-r { right: 8rpx; transform: rotate(16deg); }

/* 眼睛：平时是圆点，每 6 秒眨一次——只占动画周期的一小段，余光里几乎察觉不到 */
.cf-eye {
  position: absolute;
  top: 26rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #1A1918;
}
.cf-eye-l { left: 16rpx; }
.cf-eye-r { right: 16rpx; }
.cf-blink { animation: cfBlink 6s infinite; }
@keyframes cfBlink {
  0%, 92%, 100% { transform: scaleY(1); }
  95%           { transform: scaleY(0.1); }
}

/* 弯弯眼 */
.cf-eye-arc {
  position: absolute;
  top: 24rpx;
  width: 14rpx;
  height: 7rpx;
  border-top: 3rpx solid #1A1918;
  border-radius: 50% 50% 0 0;
}

.cf-mouth {
  position: absolute;
  top: 40rpx;
  left: 50%;
  margin-left: -7rpx;
  width: 14rpx;
  height: 7rpx;
  border-bottom: 2rpx solid #1A1918;
  border-radius: 0 0 50% 50%;
}

/* 思考时的三个小点，浅色、缓慢，只是暗示「在想」 */
.cf-dots {
  position: absolute;
  top: 8rpx;
  right: -6rpx;
  display: flex;
  gap: 4rpx;
}
.cf-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #C9573F;
  opacity: 0.25;
}
.cf-d1 { animation: cfPulse 1.4s ease-in-out infinite; }
.cf-d2 { animation: cfPulse 1.4s ease-in-out 0.2s infinite; }
.cf-d3 { animation: cfPulse 1.4s ease-in-out 0.4s infinite; }
@keyframes cfPulse {
  0%, 100% { opacity: 0.2; }
  50%      { opacity: 0.85; }
}
