/**
 * 爱情判官 UI v2 — 线稿猫 · 奶油纸 · 平面无衬线
 * 奶油纸底 + 墨黑主按钮；色彩只做小面积点缀：
 * 陶土 #C9573F（印章）、蜜色 #B0793F（标签）、抹茶 #7E9B72 / 杏色 #D9A05B（状态）
 * 无渐变、无厚投影；卡片圆角 40rpx + 1px 描边；胶囊按钮高 104rpx
 */
page {
  background: #FAF7F2;
  color: #1A1918;
  font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 26rpx;
  line-height: 1.8;
}

.wrap { padding: 24rpx 50rpx 60rpx 50rpx; }

/* 排印 */
.kicker { font-size: 20rpx; letter-spacing: 0.28em; color: #B0793F; }
.h1 { font-size: 56rpx; font-weight: 500; line-height: 1.5; letter-spacing: 2rpx; }
.h2 { font-size: 40rpx; font-weight: 500; line-height: 1.5; }
.sub { font-size: 26rpx; color: #6E685F; line-height: 1.85; }
.faint { font-size: 22rpx; color: #9C958A; line-height: 1.85; }
.center { text-align: center; }

/* 卡片：白底 1px 描边，无投影 */
.card {
  background: #FFFFFF;
  border: 1rpx solid #E1DACE;
  border-radius: 40rpx;
  padding: 40rpx;
  box-sizing: border-box;
}
.hairline { border-top: 1rpx solid #E1DACE; }

/* 胶囊按钮 */
.btn {
  height: 104rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}
.btn-primary { background: #1A1918; color: #FAF7F2; }
.btn-ghost { background: #FFFFFF; border: 1rpx solid #E1DACE; color: #1A1918; }
.btn-disabled { background: #E1DACE; color: #9C958A; }

/* 原生 button 复用 .btn 时重置默认样式 */
button.btn { padding: 0; margin: 0; line-height: inherit; }
button.btn::after { border: none; }

/* chips（情绪标签等，选中填蜜色） */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E1DACE;
  background: #FFFFFF;
  font-size: 24rpx;
  color: #6E685F;
  margin: 0 16rpx 16rpx 0;
}
.chip-on { background: #B0793F; border-color: #B0793F; color: #FAF7F2; }

/* 状态胶囊 */
.pill {
  display: inline-flex;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
}
.pill-honey { background: rgba(176, 121, 63, 0.12); color: #B0793F; }
.pill-matcha { background: rgba(126, 155, 114, 0.14); color: #7E9B72; }

/* 印章（陶土红，落章动画：0.7s 落下，旋转 -12°） */
.seal {
  width: 150rpx;
  height: 150rpx;
  border: 4rpx solid #C9573F;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #C9573F;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  line-height: 1.4;
  transform: rotate(-12deg);
  background: rgba(250, 247, 242, 0.92);
}
.seal-drop { animation: sealDrop 0.7s cubic-bezier(0.2, 0.9, 0.3, 1) both; }
@keyframes sealDrop {
  0% { transform: rotate(-12deg) scale(2.2); opacity: 0; }
  100% { transform: rotate(-12deg) scale(1); opacity: 1; }
}

/* 输入 */
.field {
  background: #FFFFFF;
  border: 1rpx solid #E1DACE;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  line-height: 1.7;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}
.field-ph { color: #C0B8A8; }

/* 通用间距 */
.mt8 { margin-top: 8rpx; } .mt16 { margin-top: 16rpx; } .mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; } .mt48 { margin-top: 48rpx; } .mt64 { margin-top: 64rpx; }
.gap { height: 24rpx; }
.grow { flex-grow: 1; }
.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }

/* 判决书分段揭晓：一段一段浮上来，让判决有揭晓感而不是一次性铺开 */
.reveal {
  opacity: 0;
  animation: rise 0.55s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
}
@keyframes rise {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 猫呼吸（开庭页等） */
.breathe { animation: breathe 4s ease-in-out infinite; }
@keyframes breathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(8rpx); }
}

/* 石子上浮 */
.float-up { animation: floatUp 0.3s ease-out both; }
@keyframes floatUp {
  0% { transform: translateY(24rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}


/* 判官小猫脸头像（原为自定义组件，内联进全局避免依赖分析误删） */
/* 64rpx 见方的小猫脸，耳朵略微探出顶部（右侧是文字，不会遮挡） */
.cf-face {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  transform-origin: 50% 90%;
}
.cf-face.cf-tilt { animation: cfTilt 2.6s ease-in-out infinite alternate; }
@keyframes cf-tilt {
  from { transform: rotate(-4deg); }
  to   { transform: rotate(4deg); }
}

.cf-head {
  position: absolute;
  inset: 0;
  border: 2rpx solid #1A1918;
  border-radius: 50%;
  background: #FFFDF9;
}

/* 耳朵：两个小三角，贴着圆的上沿 */
.cf-ear {
  position: absolute;
  top: -8rpx;
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-bottom: 14rpx solid #1A1918;
}
.cf-ear-l { left: 8rpx; transform: rotate(-16deg); }
.cf-ear-r { right: 8rpx; transform: rotate(16deg); }

/* 眼睛：平时是圆点，每 6 秒眨一次——只占动画周期的一小段，余光里几乎察觉不到 */
.cf-eye {
  position: absolute;
  top: 26rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #1A1918;
}
.cf-eye-l { left: 16rpx; }
.cf-eye-r { right: 16rpx; }
.cf-blink { animation: cfBlink 6s infinite; }
@keyframes cfBlink {
  0%, 92%, 100% { transform: scaleY(1); }
  95%           { transform: scaleY(0.1); }
}

/* 弯弯眼 */
.cf-eye-arc {
  position: absolute;
  top: 24rpx;
  width: 14rpx;
  height: 7rpx;
  border-top: 3rpx solid #1A1918;
  border-radius: 50% 50% 0 0;
}

.cf-mouth {
  position: absolute;
  top: 40rpx;
  left: 50%;
  margin-left: -7rpx;
  width: 14rpx;
  height: 7rpx;
  border-bottom: 2rpx solid #1A1918;
  border-radius: 0 0 50% 50%;
}

/* 思考时的三个小点，浅色、缓慢，只是暗示「在想」 */
.cf-dots {
  position: absolute;
  top: 8rpx;
  right: -6rpx;
  display: flex;
  gap: 4rpx;
}
.cf-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #C9573F;
  opacity: 0.25;
}
.cf-d1 { animation: cfPulse 1.4s ease-in-out infinite; }
.cf-d2 { animation: cfPulse 1.4s ease-in-out 0.2s infinite; }
.cf-d3 { animation: cfPulse 1.4s ease-in-out 0.4s infinite; }
@keyframes cfPulse {
  0%, 100% { opacity: 0.2; }
  50%      { opacity: 0.85; }
}
