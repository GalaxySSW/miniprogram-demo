<view class="col respond-page">

  <view wx:if="{{loading}}" class="card mt48 state-card qa-respond-loading qa-invite-state">
    <view class="faint">正在调出传票内容…</view>
  </view>

  <view wx:elif="{{error}}" class="card mt48 state-card qa-respond-error qa-invite-state">
    <view class="sub">{{error}}</view>
    <view class="btn btn-ghost mt24 qa-respond-retry" bindtap="retry">重新调取</view>
  </view>

  <block wx:else>

  <view wx:if="{{note}}" class="mt48 qa-respond-note">
    <text class="kicker">TA 想说</text>
    <view class="card mt16" style="border-left: 6rpx solid #B0793F; padding: 40rpx;">
      <view style="font-size: 32rpx; line-height: 1.8;">{{note}}</view>
    </view>
  </view>

  <view class="center {{note ? 'mt48' : 'mt32'}}">
    <cat mood="calm" style="display: inline-block;" />
  </view>

  <view class="mt32">
    <view class="h2">TA 已经先来说了</view>
    <view wx:if="{{brief}}" class="row mt24" style="gap: 16rpx; align-items: flex-start;">
      <text class="pill pill-honey" style="flex-shrink: 0;">案由</text>
      <view class="sub grow" style="color: #1A1918;">{{brief}}</view>
    </view>
  </view>

  <view class="mt32 col" style="gap: 24rpx;">
    <view class="card row" style="gap: 24rpx;">
      <text style="font-size: 26rpx; color: #B0793F; font-weight: 500;">一</text>
      <view class="sub grow">不评输赢。这里没有被告，被审的只是那件事。</view>
    </view>
    <view class="card row" style="gap: 24rpx;">
      <text style="font-size: 26rpx; color: #B0793F; font-weight: 500;">二</text>
      <view class="sub grow">互相保密。TA 看不到你说的原话，你也看不到 TA 的。</view>
    </view>
    <view class="card row" style="gap: 24rpx;">
      <text style="font-size: 26rpx; color: #B0793F; font-weight: 500;">三</text>
      <view class="sub grow">最后你们看到的，是同一份判决书。</view>
    </view>
  </view>

  <view class="grow" style="min-height: 48rpx;"></view>

  <view class="col" style="gap: 24rpx;">
    <view class="btn btn-primary qa-respond-continue qa-respond-start" bindtap="willTalk">好，我也说说</view>
    <view class="btn btn-ghost qa-respond-cancel qa-respond-later" bindtap="notNow">我现在不想聊这个</view>
  </view>

  </block>

</view>
