<view class="col" style="min-height: 100vh; box-sizing: border-box; padding: 24rpx 50rpx 60rpx 50rpx;">

  <view class="row" style="justify-content: space-between;">
    <text class="kicker">LOVE JUDGE</text>
    <view class="row" style="gap: 36rpx;">
      <text class="faint" bindtap="goHistory">卷宗</text>
      <text class="faint" bindtap="goProfile">我的</text>
    </view>
  </view>

  <view class="mt64">
    <view class="h1">吵不明白的架，</view>
    <view class="h1">交给本庭。</view>
    <view class="sub mt24">不判谁输谁赢，只审那个让你们受伤的误会。</view>
  </view>

  <view class="row mt64" style="justify-content: center;">
    <cat mood="calm" />
  </view>

  <view class="grow"></view>

  <view wx:if="{{pending}}" class="card mt24" bindtap="resume" style="border-left: 6rpx solid #B0793F;">
    <view class="row" style="justify-content: space-between;">
      <text style="font-size: 28rpx; font-weight: 500;">还有一桩案子等着你</text>
      <text class="pill pill-honey">未发传票</text>
    </view>
    <view class="faint mt8">{{pending.id}} · 想好了就去发给 TA →</view>
  </view>

  <view class="col mt24" style="gap: 24rpx;">
    <view class="btn btn-primary" bindtap="startCase">我要立案</view>
    <view class="btn btn-ghost" bindtap="gotSummons">我收到了传票</view>
  </view>

  <swiper class="mt32" vertical autoplay circular interval="3000" duration="600" style="height: 60rpx;">
    <swiper-item wx:for="{{quotes}}" wx:key="index">
      <view class="faint center">「{{item}}」</view>
    </swiper-item>
  </swiper>

</view>
