/* Figma: home-default / proto-home-default */
.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 88rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FAF7F2;
  color: #1A1918;
}

.home-main { flex: 1; }

.home-topbar {
  height: 104rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-brand { display: flex; align-items: center; gap: 16rpx; }
.home-brand-mascot {
  width: 64rpx;
  height: 56rpx;
  flex-shrink: 0;
}
.home-brand-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  color: #1A1918;
}
.home-archive-row {
  height: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding-left: 80rpx;
}
.home-archive-link {
  color: #6E685F;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.home-hero {
  padding: 24rpx 0 48rpx;
  box-sizing: border-box;
}
.home-hero-title {
  display: block;
  color: #1A1918;
  font-size: 50rpx;
  font-weight: 500;
  line-height: 88rpx;
  letter-spacing: 0;
}
.home-hero-copy {
  display: block;
  margin-top: 40rpx;
  color: #6E685F;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.home-companion {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 32rpx 0;
  box-sizing: border-box;
}
.home-companion-mascot {
  width: 128rpx;
  height: 110rpx;
}
.home-start-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 104rpx;
  min-height: 104rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #3B2919;
  color: #FAF7F2;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 52rpx;
}
.home-start-button-disabled { opacity: .7; }

.home-cases { padding-top: 32rpx; }
.home-rule { height: 2rpx; background: #E1DACE; }
.home-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 32rpx 0 16rpx;
}
.home-section-title-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.home-section-title {
  flex-shrink: 0;
  color: #1A1918;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 52rpx;
}
.home-case-number {
  max-width: 210rpx;
  overflow: hidden;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #FFD9C7;
  color: #B0793F;
  font-family: 'Inter', 'SF Pro Text', sans-serif;
  font-size: 24rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-case-status {
  flex-shrink: 0;
  max-width: 170rpx;
  overflow: hidden;
  color: #B0793F;
  font-size: 26rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-case-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 16rpx 0 32rpx;
  border-bottom: 2rpx solid #E1DACE;
  box-sizing: border-box;
}
.home-case-row-action:active { opacity: .62; }
.home-case-title {
  min-width: 0;
  overflow: hidden;
  color: #6E685F;
  font-size: 28rpx;
  line-height: 52rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-case-action {
  flex-shrink: 0;
  max-width: 190rpx;
  overflow: hidden;
  color: #3B2919;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 52rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-completed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 32rpx 0 16rpx;
}
.home-completed-label {
  color: #6E685F;
  font-size: 28rpx;
  line-height: 52rpx;
}
.home-completed-value {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #1A1918;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 52rpx;
  white-space: nowrap;
}
.home-success-dot {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #7E9B72;
}

.home-empty-hint {
  margin-top: 32rpx;
  padding: 28rpx 0;
  border-top: 2rpx solid #E1DACE;
  border-bottom: 2rpx solid #E1DACE;
  color: #6E685F;
  font-size: 26rpx;
  line-height: 48rpx;
  text-align: center;
}
.home-secondary-actions { margin-top: 32rpx; }
.home-secondary-button {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 2rpx solid #E1DACE;
  border-radius: 999rpx;
  background: #FAF7F2;
  color: #1A1918;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.home-secondary-button::after { border: 0; }

.home-footer {
  flex-shrink: 0;
  padding-top: 32rpx;
  color: #9C958A;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}


/* 入口靠左：右上角被微信胶囊按钮占着，任何内容放那儿都会被遮 */
.home-nav {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 12rpx; padding-right: 200rpx;
}
.home-nav-link { font-size: 24rpx; color: var(--panpan-text-tertiary); }
.home-nav-sep { font-size: 24rpx; color: var(--panpan-text-tertiary); opacity: 0.5; }

/* 新进展提醒 */
.home-news {
  display: flex; align-items: flex-start; gap: 16rpx;
  margin-top: 24rpx; padding: 24rpx 28rpx;
  background: var(--panpan-surface-card, #FFFFFF);
  border: 1rpx solid var(--panpan-border-subtle, #E1DACE);
  border-left: 6rpx solid #C9573F;
  border-radius: 24rpx;
}
.home-news-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #C9573F; margin-top: 12rpx; flex-shrink: 0;
}
.home-news-body { display: flex; flex-direction: column; gap: 6rpx; flex: 1; }
.home-news-text { font-size: 26rpx; font-weight: 500; }
.home-news-meta { font-size: 20rpx; color: var(--panpan-text-tertiary); }
