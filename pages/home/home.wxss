/* Figma: home-default / proto-home-default */
.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 40rpx 32rpx;
  background: #FAF7F2;
  color: #1A1918;
}

.home-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 24rpx 0 12rpx;
  box-sizing: border-box;
}

.home-brand,
.home-brand-copy,
.home-nav,
.home-section-heading,
.home-case-meta,
.home-news-row {
  display: flex;
  align-items: center;
}

.home-brand { gap: 16rpx; }
.home-brand-mark {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #1A1918;
  border-radius: 50%;
  background: #FFFDF9;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}
.home-brand-copy { flex-direction: column; align-items: flex-start; gap: 0; }
.home-brand-name { font-size: 32rpx; font-weight: 500; line-height: 1.25; }
.home-brand-caption { color: #6E685F; font-size: 20rpx; line-height: 1.4; }

.home-nav { gap: 22rpx; }
.home-nav-button {
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: #6E685F;
  font-size: 24rpx;
  line-height: 48rpx;
}
.home-nav-button::after { border: 0; }

.home-hero { padding: 56rpx 0 24rpx; }
.home-hero-title {
  display: block;
  max-width: 650rpx;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.25;
  letter-spacing: 1rpx;
}
.home-hero-copy {
  display: block;
  margin-top: 24rpx;
  color: #6E685F;
  font-size: 26rpx;
  line-height: 1.65;
}

.home-companion {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.home-start-button,
.home-secondary-button {
  width: 100%;
  box-sizing: border-box;
}
.home-start-button { margin-top: 12rpx; }

.home-cases { margin-top: 48rpx; }
.home-rule { height: 1rpx; background: #E1DACE; }
.home-section-heading {
  justify-content: space-between;
  padding: 28rpx 0 20rpx;
}
.home-section-title { font-size: 30rpx; font-weight: 500; line-height: 1.5; }
.home-section-link,
.home-case-action { color: #3B2919; font-size: 24rpx; line-height: 1.5; }

.home-case-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E1DACE;
  box-sizing: border-box;
}
.home-case-row-action:active,
.home-news-row:active { opacity: .62; }
.home-case-main { min-width: 0; flex: 1; }
.home-case-meta { gap: 12rpx; flex-wrap: wrap; }
.home-case-number { color: #B0793F; font-size: 21rpx; line-height: 1.5; }
.home-case-title {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #6E685F;
  font-size: 26rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-case-action { flex-shrink: 0; font-weight: 500; }

.home-news-row { gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #E1DACE; }
.home-news-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #C9573F;
}
.home-news-copy { min-width: 0; flex: 1; }
.home-news-title,
.home-news-sub { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.home-news-title { font-size: 26rpx; line-height: 1.5; }
.home-news-sub { margin-top: 4rpx; color: #9C958A; font-size: 21rpx; line-height: 1.5; }
.home-news-badge {
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(201, 87, 63, .1);
  color: #C9573F;
  font-size: 20rpx;
  line-height: 1.5;
}

.home-empty-hint {
  margin-top: 48rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid #E1DACE;
  border-bottom: 1rpx solid #E1DACE;
  color: #6E685F;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}
.home-secondary-actions { margin-top: 24rpx; }
.home-secondary-button { height: 88rpx; font-size: 26rpx; }

.home-footer {
  padding-top: 32rpx;
  color: #9C958A;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}
.home-quotes { height: 48rpx; margin-top: 16rpx; }
.home-quote { color: #9C958A; font-size: 21rpx; line-height: 48rpx; }
