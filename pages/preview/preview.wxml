<view class="col preview-page">

  <view class="h2 mt16">用你自己的话开口</view>
  <view class="card mt32 preview-editor accent-card">
    <textarea value="{{note}}" bindinput="onNoteInput" auto-height maxlength="60"
      placeholder="写一句你自己的话" placeholder-class="field-ph"
      class="field field-note qa-preview-note" />
  </view>
  <view class="mt24">
    <text wx:for="{{templates}}" wx:key="index" class="chip {{tplIdx === index ? 'chip-on' : ''}}"
      data-idx="{{index}}" bindtap="pickTpl">{{item}}</text>
  </view>

  <view class="mt48">
    <text class="kicker">案由 · TA 会看到这是关于什么事</text>
    <view class="card mt16 preview-editor">
      <view wx:if="{{briefLoading}}" class="faint">判官正在把你的陈述提炼成一句中立的案由…</view>
      <block wx:else>
        <view wx:if="{{briefError}}" class="state-card qa-preview-brief-error">
          <view class="sub">{{briefError}}</view>
        </view>
        <textarea value="{{brief}}" bindinput="onBriefInput" auto-height maxlength="60"
          placeholder="关于……这件事" placeholder-class="field-ph"
          class="field field-brief qa-preview-brief" />
      </block>
    </view>
  </view>

  <view class="hairline mt48 privacy-section">
    <view class="card qa-preview-privacy">
      <view class="row" style="gap: 16rpx; align-items: flex-start;">
        <text class="pill pill-matcha">能看到</text>
        <view class="sub grow">你写的这句话、案由、案号</view>
      </view>
      <view class="row mt16" style="gap: 16rpx; align-items: flex-start;">
        <text class="pill pill-honey">看不到</text>
        <view class="sub grow">你的陈述原话、你上传的截图</view>
      </view>
    </view>
  </view>

  <view class="grow" style="min-height: 48rpx;"></view>

  <view wx:if="{{saveError}}" class="card state-card qa-preview-save-error">
    <view class="sub">{{saveError}}</view>
    <view class="btn btn-ghost mt24 qa-preview-retry" bindtap="retryConfirm">重试保存</view>
  </view>

  <view class="col action-stack">
    <view class="btn {{saving ? 'btn-disabled' : 'btn-primary'}} qa-preview-confirm qa-preview-send" bindtap="confirm">
      {{saving ? '正在保存…' : '确认，去发传票'}}
    </view>
    <view class="btn btn-ghost qa-preview-edit" bindtap="edit">我再改改陈述</view>
  </view>

</view>
