.preview-page { min-height: 100vh; box-sizing: border-box; padding: calc(24rpx + env(safe-area-inset-top)) 50rpx calc(60rpx + env(safe-area-inset-bottom)); }
.preview-header { justify-content: space-between; min-height: 44rpx; }
.preview-editor { background: #FFFDF9; }
.accent-card { border-left: 6rpx solid #B0793F; }
.field-note { min-height: 90rpx; padding: 0; background: transparent; border: 0; }
.field-brief { min-height: 80rpx; padding: 0; background: transparent; border: 0; }
.privacy-section { padding-top: 48rpx; }
.state-card { background: #FFFDF9; }
.action-stack { gap: 24rpx; }

.pv-no { font-size: 26rpx; font-weight: 600; color: #B0793F; }
.pv-title { font-size: 30rpx; font-weight: 500; }
