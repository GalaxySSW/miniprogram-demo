/* Figma: evidence */
.evidence-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #FAF7F2;
  color: #1A1918;
}

.page-header {
  height: 176rpx;
  padding: 88rpx 40rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.page-back {
  width: 52rpx;
  height: 52rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: #1A1918;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 44rpx;
  text-align: left;
}
.page-back { display: flex; align-items: center; justify-content: flex-start; }
.page-title { flex: 1; margin-left: 8rpx; font-size: 34rpx; font-weight: 500; line-height: 1.4; }
.page-capsule {
  min-width: 92rpx;
  height: 44rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, .1);
  border-radius: 24rpx;
  background: rgba(0, 0, 0, .04);
  font-size: 22rpx;
  line-height: 1;
}
.page-capsule-divider { width: 1rpx; height: 22rpx; background: rgba(0, 0, 0, .12); }

.evidence-content { padding: 24rpx 48rpx 48rpx; }
.evidence-content { overflow: hidden; }
.step-indicator { display: flex; flex-direction: column; gap: 12rpx; }
.step-label { color: #6E685F; font-size: 22rpx; line-height: 1.5; }
.evidence-title { font-size: 44rpx; font-weight: 500; line-height: 1.35; }
.evidence-subtitle { color: #3B2919; font-size: 26rpx; line-height: 1.65; }

.evidence-upload-card {
  margin-top: 40rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border: 1rpx solid #E1DACE;
  border-radius: 24rpx;
  background: #FFFDF9;
}
.evidence-upload-heading { display: flex; align-items: center; justify-content: space-between; }
.evidence-upload-title { max-width: 70%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.evidence-upload-count { color: #6E685F; font-size: 22rpx; line-height: 1.5; }
.evidence-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 24rpx; }
.evidence-image-wrap,
.evidence-add { width: 188rpx; height: 188rpx; box-sizing: border-box; }
.evidence-image-wrap { position: relative; }
.evidence-image { width: 100%; height: 100%; border: 1rpx solid #E1DACE; border-radius: 16rpx; }
.evidence-remove {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 44rpx;
  height: 44rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #1A1918;
  color: #FAF7F2;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 42rpx;
}
.evidence-remove::after { border: 0; }
.evidence-add {
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #B9AFA2;
  border-radius: 16rpx;
  background: #FAF7F2;
  color: #8C7C70;
}
.evidence-add::after { border: 0; }
.evidence-add-icon { font-size: 52rpx; font-weight: 300; line-height: 1; }
.evidence-add-label { margin-top: 12rpx; font-size: 22rpx; line-height: 1.5; }
.evidence-hint { display: block; margin-top: 20rpx; color: #9C958A; font-size: 21rpx; line-height: 1.5; }

.privacy-notice {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  border: 1rpx solid #B0793F;
  border-radius: 12rpx;
  background: rgba(176, 121, 63, .1);
  color: #1A1918;
  font-size: 21rpx;
  line-height: 1.5;
}
.privacy-icon { color: #C9573F; font-size: 24rpx; line-height: 1; }

.evidence-actions { margin-top: 48rpx; }
.evidence-actions .btn { width: 100%; }
.evidence-skip {
  display: block;
  margin: 24rpx auto 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #6E685F;
  font-size: 22rpx;
  line-height: 1.5;
}
.evidence-skip::after { border: 0; }
