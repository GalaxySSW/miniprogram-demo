<view class="col pact-page">

  <view class="row pact-header">
    <text class="faint qa-pact-back" bindtap="back">‹ 返回</text>
    <text class="kicker">本庭约定</text>
  </view>

  <view wx:if="{{syncLoading}}" class="card mt24 state-card qa-pact-loading">
    <view class="faint">正在看看双方最新的点头状态…</view>
  </view>
  <view wx:if="{{error}}" class="card mt24 state-card qa-pact-error">
    <view class="sub">{{error}}</view>
    <view class="btn btn-ghost mt24 qa-pact-retry" bindtap="retry">重新同步</view>
  </view>

  <!-- 我来选 -->
  <block wx:if="{{stage === 'choose'}}">
    <text class="kicker">本庭约定</text>
    <view class="h2 mt16">这次先一起试试这一件</view>
    <view class="sub mt8">{{fromAI ? '判官照着你们这桩案子拟了三条，挑一条最做得到的。' : '不用许大愿，一件双方都点头的小事就够。'}}</view>

    <view class="mt48 col" style="gap: 24rpx;">
      <view wx:for="{{pacts}}" wx:key="index" bindtap="pickPact" data-idx="{{index}}"
        class="card pact-choice {{pactIdx === index ? 'pact-choice-selected' : ''}} qa-pact-choice">
        <view class="row" style="justify-content: space-between;">
          <text style="font-size: 30rpx; font-weight: 500;">{{item.title}}</text>
          <text wx:if="{{pactIdx === index}}" style="color: #B0793F;">✓</text>
        </view>
        <view class="sub mt8">{{item.desc}}</view>
      </view>
    </view>

    <view class="card mt32 row qa-pact-review" style="gap: 20rpx; align-items: flex-start;" bindtap="toggleReview">
      <view style="flex-shrink: 0; width: 36rpx; height: 36rpx; border-radius: 10rpx; border: 2rpx solid {{wantReview ? '#B0793F' : '#E1DACE'}}; background: {{wantReview ? '#B0793F' : '#FFFFFF'}}; display: flex; align-items: center; justify-content: center;">
        <text wx:if="{{wantReview}}" style="color: #FAF7F2; font-size: 22rpx;">✓</text>
      </view>
      <view class="col grow">
        <view style="font-size: 28rpx;">过几天，让本庭来问问</view>
        <view class="faint mt8">不勾也没关系。本庭会一直记着这件事，下次为同一件事开庭时自然会提。</view>
      </view>
    </view>

    <view class="btn {{submitting ? 'btn-disabled' : 'btn-primary'}} mt32 qa-pact-choose qa-pact-submit" bindtap="choose">{{submitting ? '正在保存…' : '就这件 · 交给 TA 点头'}}</view>
    <view class="faint center mt16">约定要两个人都同意才算数</view>
  </block>

  <!-- 我定好了，等 TA -->
  <block wx:elif="{{stage === 'wait'}}">
    <text class="kicker">本庭约定</text>
    <view class="h2 mt16">等 TA 点个头</view>
    <view class="sub mt8">约定要两个人都同意才算数。TA 那边会看到这一件。</view>

    <view class="card mt48" style="border-left: 6rpx solid #B0793F;">
      <view style="font-size: 32rpx; font-weight: 500;">{{chosen.title}}</view>
      <view class="sub mt16">{{chosen.desc}}</view>
      <view class="row mt24" style="gap: 24rpx;">
        <text class="pill pill-matcha">你已确认</text>
        <text class="pill pill-honey">等待 TA 确认</text>
      </view>
    </view>

    <view class="center mt48"><cat mood="sleep" breathe="{{true}}" style="display: inline-block;" /></view>

    <view class="grow"></view>
    <view class="btn btn-ghost qa-pact-history" bindtap="goHistory">先回卷宗</view>
  </block>

  <!-- TA 定了，等我点头 -->
  <block wx:elif="{{stage === 'confirm'}}">
    <text class="kicker">本庭约定</text>
    <view class="h2 mt16">TA 定了这一件</view>
    <view class="sub mt8">你点头，本案就了结。还没想好也没关系，可以先递颗石子。</view>

    <view class="card mt48" style="border-left: 6rpx solid #B0793F;">
      <view style="font-size: 32rpx; font-weight: 500;">{{chosen.title}}</view>
      <view class="sub mt16">{{chosen.desc}}</view>
      <view class="row mt24" style="gap: 24rpx;">
        <text class="pill pill-matcha">TA 已确认</text>
        <text class="pill pill-honey">等你点头</text>
      </view>
    </view>

    <view class="grow"></view>
    <view class="btn {{submitting ? 'btn-disabled' : 'btn-primary'}} qa-pact-confirm" bindtap="confirm">{{submitting ? '正在保存…' : '我也同意 · 就这件'}}</view>
    <view class="center mt24"><text class="faint" bindtap="goPebble">还没想好，先递颗石子</text></view>
  </block>

  <!-- 双方齐了 -->
  <block wx:else>
    <view class="center mt64"><cat mood="happy" style="display: inline-block;" /></view>
    <view class="h2 center mt32">本案了结</view>
    <view class="sub center mt8">你们都点头了。本庭把这件事记下了。</view>

    <view class="card mt48" style="border-left: 6rpx solid #7E9B72;">
      <view style="font-size: 32rpx; font-weight: 500;">{{chosen.title}}</view>
      <view class="sub mt16">{{chosen.desc}}</view>
      <view class="row mt24" style="gap: 24rpx;">
        <text class="pill pill-matcha">双方已确认</text>
      </view>
    </view>

    <view class="grow"></view>
    <view class="btn btn-ghost qa-pact-history" bindtap="goHistory">去卷宗看看</view>
  </block>

  <view wx:if="{{stage !== 'choose'}}" class="hairline mt64 pact-footer">
    <view class="faint center qa-pact-pebble" bindtap="goPebble">说不出话的时候，还可以递颗石子 →</view>
  </view>

</view>
