<view class="col" style="min-height: 100vh; box-sizing: border-box; padding: 24rpx 50rpx 60rpx 50rpx;">

  <block wx:if="{{!fromNotNow}}">
    <text class="kicker">本庭约定</text>
    <view class="h2 mt16">这次先一起试试这一件</view>
    <view class="sub mt8">{{fromAI ? '判官照着你们这桩案子拟了三条，挑一条最做得到的。' : '不用许大愿，一件双方都点头的小事就够。'}}</view>

    <view class="mt48 col" style="gap: 24rpx;">
      <view wx:for="{{pacts}}" wx:key="index" bindtap="pickPact" data-idx="{{index}}"
        class="card" style="border-color: {{pactIdx === index ? '#B0793F' : '#E1DACE'}}; border-width: {{pactIdx === index ? '3rpx' : '1rpx'}};">
        <view class="row" style="justify-content: space-between;">
          <text style="font-size: 30rpx; font-weight: 500;">{{item.title}}</text>
          <text wx:if="{{pactIdx === index}}" style="color: #B0793F;">✓</text>
        </view>
        <view class="sub mt8">{{item.desc}}</view>
      </view>
    </view>

    <view class="btn btn-primary mt48" bindtap="confirmPact">就这件 · 双方确认</view>
    <view class="faint center mt16">三天后，本庭会回来问问这个约定有没有帮助</view>

    <view class="hairline mt64"></view>
  </block>

  <view class="{{fromNotNow ? '' : 'mt48'}}">
    <text class="kicker">冷战通道</text>
    <view class="h2 mt16">还说不出话？</view>
    <view class="sub mt8">递一颗石子过去——不用解释，只告诉 TA：我还在。</view>
    <view class="btn btn-ghost mt32" bindtap="goPebble">去递一颗石子</view>
  </view>

  <view class="grow"></view>

</view>
