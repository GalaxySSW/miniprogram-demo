<view class="col history-page">

  <view class="row history-header">
    <text class="kicker">卷宗</text>
  </view>

  <view class="h2 mt16">你们的案底</view>
  <view wx:if="{{loading}}" class="card mt48 state-card qa-history-loading">
    <view class="faint">正在翻看你们的卷宗…</view>
  </view>

  <view wx:elif="{{error}}" class="card mt48 state-card qa-history-error">
    <view class="sub">{{error}}</view>
    <view class="btn btn-ghost mt24 qa-history-retry" bindtap="retry">重新调卷</view>
  </view>

  <view wx:else class="mt48 col history-list qa-history-list">
    <view wx:for="{{cases}}" wx:key="id" class="card qa-history-case qa-history-card">
        <view bindtap="openCase" data-docid="{{item.docId}}" class="qa-history-open">
        <view class="row" style="justify-content: space-between;">
          <text style="font-size: 30rpx; font-weight: 500;">{{item.title}}</text>
          <text class="pill {{item.status === 'done' ? 'pill-matcha' : 'pill-honey'}}">{{item.statusText}}</text>
        </view>
        <view class="faint mt8">{{item.id}}</view>
        <view class="sub mt8">{{item.pact}}</view>
      </view>
      <view wx:if="{{item.canReview}}" class="hairline mt24" style="padding-top: 24rpx;">
        <text class="faint qa-history-review" bindtap="goReview" data-docid="{{item.docId}}">三天到了 · 去复盘这个约定 →</text>
      </view>
    </view>
  </view>

  <view class="grow"></view>
  <view class="faint center qa-history-retention">判决后 7 天，证据自动销毁</view>


  <view class="home-exit" bindtap="goHome">回首页</view>

</view>
