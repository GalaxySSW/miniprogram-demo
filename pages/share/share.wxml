<view class="col" style="min-height: 100vh; box-sizing: border-box; padding: 24rpx 50rpx 60rpx 50rpx;">

  <text class="kicker">传票</text>
  <view class="h2 mt16">递给 TA</view>
  <view class="sub mt8">这句话会出现在你们的聊天里，TA 点开就是应诉页。</view>

  <view class="card mt32" style="padding: 40rpx;">
    <view class="row" style="gap: 24rpx;">
      <cat mood="calm" bg="#FFFFFF" style="transform: scale(0.55); transform-origin: left center; width: 130rpx;" />
      <view class="col grow">
        <view style="font-size: 28rpx; font-weight: 500; line-height: 1.6;">{{note}}</view>
        <view class="faint mt8">爱情判官 · {{caseId}}</view>
      </view>
    </view>
  </view>

  <view class="mt48">
    <view class="btn btn-primary" style="width: 100%;">
      <button open-type="share" style="width: 100%; height: 100%; background: transparent; color: #FAF7F2; font-size: 30rpx; font-weight: 500; letter-spacing: 4rpx; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">转发给 TA</button>
    </view>
  </view>

  <view wx:if="{{code}}" class="card mt32" style="border-left: 6rpx solid #B0793F;">
    <view class="row" style="justify-content: space-between; align-items: baseline;">
      <text class="pill pill-honey">转发用不了？用口令</text>
      <text class="faint">{{copied ? '已复制' : ''}}</text>
    </view>
    <view class="center mt24" style="font-size: 64rpx; font-weight: 500; letter-spacing: 12rpx;">{{code}}</view>
    <view class="faint center mt8">TA 在首页点「我收到了传票」，输入这六位</view>
    <view class="btn btn-ghost mt24" bindtap="copyInvite">复制邀请语和口令</view>
  </view>

  <view class="grow" style="min-height: 32rpx;"></view>

  <view class="col" style="gap: 24rpx;">
    <view class="btn btn-ghost" bindtap="simulateTa">演示：切到 TA 视角</view>
    <view class="center"><text class="faint" bindtap="goWaiting">发好了 · 去等 TA</text></view>
  </view>

</view>
