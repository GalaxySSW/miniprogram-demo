<view class="col share-page">

  <view class="row share-header">
    <text class="kicker">传票</text>
  </view>

  <view class="h2 mt16">递给 TA</view>
  <view class="sub mt8">这句话会出现在你们的聊天里。</view>

  <view class="card mt32 invite-card qa-share-invite">
    <view class="row" style="gap: 24rpx;">
      <cat mood="calm" bg="#FFFFFF" style="transform: scale(0.55); transform-origin: left center; width: 130rpx;" />
      <view class="col grow">
        <view style="font-size: 28rpx; font-weight: 500; line-height: 1.6;">{{note}}</view>
        <view class="faint mt8">爱情判官 · {{caseId}}</view>
      </view>
    </view>
  </view>

  <view class="mt48">
    <view class="btn btn-primary share-button qa-share-native qa-share-send">
      <button open-type="share" class="share-native-button">转发给 TA</button>
    </view>
  </view>

  <view wx:if="{{codeLoading}}" class="card mt32 state-card qa-share-loading">
    <view class="faint">正在调出口令…</view>
  </view>

  <view wx:if="{{codeError}}" class="card mt32 state-card qa-share-error">
    <view class="sub">{{codeError}}</view>
    <view class="btn btn-ghost mt24 qa-share-retry" bindtap="retryCode">重新获取口令</view>
  </view>

  <view wx:if="{{code}}" class="card mt32 invite-code-card qa-share-code" >
    <view class="row" style="justify-content: space-between; align-items: baseline;">
      <text class="pill pill-honey">转发用不了？用口令</text>
      <text class="faint">{{copied ? '已复制' : ''}}</text>
    </view>
    <view class="center mt24" style="font-size: 64rpx; font-weight: 500; letter-spacing: 12rpx;">{{code}}</view>
    <view class="faint center mt8">TA 在首页点「我收到了传票」，输入这六位</view>
    <view class="btn btn-ghost mt24 qa-share-copy" bindtap="copyInvite">复制邀请语和口令</view>
  </view>

  <view class="privacy-note mt24 qa-share-privacy">
    <text class="pill pill-matcha">隐私提示</text>
    <text class="faint grow">TA 只会看到邀请语和案由，不会看到你的陈述或截图。</text>
  </view>

  <view class="grow" style="min-height: 32rpx;"></view>

  <view class="col action-stack">
    <view class="btn btn-ghost qa-share-simulate qa-share-demo" bindtap="simulateTa">演示：切到 TA 视角</view>
    <view class="center"><text class="faint qa-share-waiting" bindtap="goWaiting">发好了 · 去等 TA</text></view>
  </view>

</view>
