<view class="statement-page">
  <view class="page-header">
    <view id="qa-statement-back" class="page-back" bindtap="goBack">‹</view>
  </view>

  <view class="statement-content">
    <view class="statement-step">
      <text class="step-label">立案 · 第二步</text>
      <text class="statement-title">慢慢说，本庭在听</text>
      <text class="statement-subtitle">一次只问一句，想到什么说什么。</text>
    </view>

    <view wx:if="{{hasEvidence}}" id="qa-statement-evidence-read" class="statement-evidence-card">
      <text class="pill pill-matcha">已阅</text>
      <text class="statement-evidence-copy">截图已阅，说说你的感受。</text>
    </view>

    <view class="statement-questions">
      <block wx:for="{{questions}}" wx:key="key">
        <view wx:if="{{index < shown}}" id="qa-statement-question-{{index}}" class="statement-card reveal {{activeKey == item.key ? 'is-active' : ''}}">
          <view class="statement-card-heading">
            <text class="statement-question">{{item.q}}</text>
            <text class="statement-progress">{{index + 1}}/3</text>
          </view>
          <textarea id="qa-statement-field-{{item.key}}" class="statement-field" placeholder="{{item.ph}}" placeholder-class="field-ph"
            value="{{answers[item.key]}}" data-key="{{item.key}}"
            bindinput="onInput" bindfocus="onFocus" auto-height maxlength="800" />
        </view>
      </block>

      <view wx:if="{{shown < 3}}" id="qa-statement-next-question" class="statement-more" bindtap="showNext">还想多说一点？再来一句 →</view>

      <view wx:if="{{extra}}" id="qa-statement-extra" class="statement-card reveal {{activeKey == 'extra' ? 'is-active' : ''}}">
        <text class="statement-question">还想补充的</text>
        <textarea id="qa-statement-field-extra" class="statement-field" placeholder="想到什么补什么" placeholder-class="field-ph"
          value="{{extraText}}" data-key="extra"
          bindinput="onExtraInput" bindfocus="onFocus" auto-height maxlength="800" />
      </view>
      <view wx:elif="{{shown >= 3}}" id="qa-statement-add-extra" class="statement-more" bindtap="addExtra">＋ 再补一句</view>
    </view>

    <view id="qa-statement-privacy" class="privacy-notice statement-privacy">
      <text class="privacy-icon">▣</text>
      <text>你说的这些，TA 不会看到原话。</text>
    </view>

    <view id="qa-statement-submit" class="btn {{canSubmit && !submitting ? 'btn-primary' : 'btn-disabled'}} statement-submit" bindtap="submit">
      {{submitting ? '本庭正在接住你的话…' : (canSubmit ? '呈上本庭' : '先说一句，本庭才好接')}}
    </view>
  </view>

  <view class="statement-voice-dock">
    <text class="statement-voice-hint">
      {{transcribing ? '判官正在听写…' : (recording ? '松开结束 · 说完这段' : '不想打字？按住说，转成文字填进正在写的那一栏')}}
    </text>
    <view id="qa-statement-voice" class="voice-button {{recording || transcribing ? 'voice-button-active' : ''}}"
      bindtouchstart="recStart" bindtouchend="recEnd" bindtouchcancel="recEnd">
      <text class="voice-icon">♩</text>
      <text>{{transcribing ? '正在听写…' : (recording ? '正在录音…' : '按住说话')}}</text>
    </view>
  </view>
</view>
