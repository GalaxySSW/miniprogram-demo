<view class="col" style="min-height: 100vh; box-sizing: border-box; padding: 24rpx 50rpx 220rpx 50rpx;">

  <text class="kicker">立案 · 第二步</text>
  <view class="h2 mt16">慢慢说，本庭在听</view>
  <view class="sub mt8">不用组织语言，想到什么说什么。可以打字，也可以按住下面的按钮说。</view>

  <view wx:if="{{hasEvidence}}" class="card mt24 row" style="gap: 20rpx; padding: 24rpx 32rpx;">
    <text class="pill pill-matcha">已阅</text>
    <view class="faint grow">你的聊天截图判官已经看过了，下面只说你的感受就行。</view>
  </view>

  <view class="mt48 col" style="gap: 32rpx;">
    <view class="card" wx:for="{{questions}}" wx:key="key"
      style="border-color: {{activeKey === item.key ? '#B0793F' : '#E1DACE'}};">
      <view style="font-size: 28rpx; font-weight: 500;">{{item.q}}</view>
      <textarea class="mt16" placeholder="{{item.ph}}" placeholder-class="field-ph"
        value="{{answers[item.key]}}" data-key="{{item.key}}"
        bindinput="onInput" bindfocus="onFocus" auto-height maxlength="800"
        style="width: 100%; font-size: 28rpx; line-height: 1.7; min-height: 120rpx;" />
    </view>

    <view class="card" wx:if="{{extra}}" style="border-color: {{activeKey === 'extra' ? '#B0793F' : '#E1DACE'}};">
      <view style="font-size: 28rpx; font-weight: 500;">还想补充的</view>
      <textarea class="mt16" placeholder="想到什么补什么" placeholder-class="field-ph"
        value="{{extraText}}" data-key="extra"
        bindinput="onExtraInput" bindfocus="onFocus" auto-height maxlength="800"
        style="width: 100%; font-size: 28rpx; line-height: 1.7; min-height: 120rpx;" />
    </view>
    <view wx:else class="center"><text class="faint" bindtap="addExtra">＋ 再补一句</text></view>
  </view>

  <view class="btn btn-primary mt48" bindtap="submit">呈上本庭</view>
  <view class="faint center mt24">你说的这些，TA 不会看到原话</view>
</view>

<!-- 按住说话：固定在底部 -->
<view style="position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 50rpx 40rpx; background: #FAF7F2; border-top: 1rpx solid #E1DACE;">
  <view class="faint center" style="margin-bottom: 12rpx;">
    {{transcribing ? '判官正在听写…' : (recording ? '松开结束 · 说完这段' : '按住说话，转成文字填进上面选中的那一栏')}}
  </view>
  <view class="btn {{recording ? 'btn-disabled' : 'btn-ghost'}}"
    bindtouchstart="recStart" bindtouchend="recEnd" bindtouchcancel="recEnd">
    {{recording ? '正在录音…' : '🎙 按住说话'}}
  </view>
</view>
