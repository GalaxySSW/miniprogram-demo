<view class="col verdict-page">

  <view class="row verdict-header">
    <text class="kicker">判决书</text>
  </view>

  <view class="center mt24">
    <cat mood="happy" style="display: inline-block;" />
    <view style="font-size: 44rpx; font-weight: 500; letter-spacing: 12rpx; margin-top: 16rpx;">判 决 书</view>
    <view class="faint mt8">案号 {{caseId}}</view>
  </view>

  <view wx:if="{{isMock}}" class="faint center mt16 qa-verdict-mock" style="color: #C9573F;">
    ⚠︎ 本次未接通判官，以下为样例判决
  </view>

  <view wx:if="{{billingSummary.visible}}" class="card mt24 verdict-billing-card verdict-billing-{{billingSummary.tone}} qa-verdict-billing">
    <view class="row verdict-billing-main">
      <view class="grow">
        <view class="kicker">本庭积分</view>
        <view class="sub mt8" style="color: #1A1918;">{{billingSummary.title}}</view>
      </view>
      <view wx:if="{{billingSummary.amountVisible}}" class="verdict-billing-amount">
        <text>{{billingSummary.amount}}</text><text class="faint"> 积分</text>
      </view>
    </view>
    <view class="faint mt12">{{billingSummary.detail}}</view>
    <view wx:if="{{billingSummary.hasRemaining}}" class="faint mt8">当前可用 {{billingSummary.remaining}} 积分</view>
  </view>

  <view wx:if="{{depthLoading}}" class="card mt24 state-card qa-verdict-loading">
    <view class="faint">本庭正在补充更深一层的解读…</view>
  </view>
  <view wx:if="{{depthError}}" class="card mt24 state-card qa-verdict-error">
    <view class="sub">{{depthError}}</view>
    <view class="btn btn-ghost mt24 qa-verdict-retry" bindtap="retryDepth">重试解读</view>
  </view>

  <view wx:if="{{absent}}" class="reveal card mt24 qa-verdict-absent" style="border-left: 6rpx solid #B0793F;">
    <text class="pill pill-honey">缺席审判</text>
    <view class="sub mt16" style="color: #1A1918;">TA 还没有到庭，这份判决只听了一面之词。</view>
    <view class="faint mt8">等 TA 来了，本庭会重新审一次。在那之前，下面这些只是本庭的推测。</view>
  </view>

  <view class="hairline mt32"></view>

  <view wx:if="{{v.memory && v.memory.count > 1}}" class="reveal card mt32" style="border-left: 6rpx solid #B0793F; animation-delay: 0.2s;">
    <view class="row" style="gap: 16rpx;">
      <text class="pill pill-honey">本庭记得</text>
      <text class="faint">第 {{v.memory.count}} 次</text>
    </view>
    <view class="sub mt16" style="color: #1A1918;">关于「{{v.topic}}」，你们已经是第 {{v.memory.count}} 次开庭。</view>
    <view wx:if="{{v.memory.lastPact}}" class="faint mt8">上次的约定是「{{v.memory.lastPact}}」，复盘结果：{{v.memory.lastResult || '待复盘'}}。</view>
    <view class="faint mt8">本庭记的是你们之间反复出现的这件事，不是谁的性格。</view>
  </view>

  <view class="reveal mt48 qa-verdict-section" style="animation-delay: 0.3s">
    <text class="kicker">案情还原</text>
    <view class="card mt16"><view class="sub" style="color: #1A1918;">{{v.caseBrief}}</view></view>
  </view>

  <view wx:if="{{hasWords}}" class="reveal mt48" style="animation-delay: 0.75s">
    <text class="kicker">证词翻译</text>
    <view wx:if="{{v.herWord}}" class="card mt16">
      <view class="faint">先开口的那位说</view>
      <view style="font-size: 30rpx; font-weight: 500;" class="mt8">{{v.herWord}}</view>
      <view class="faint mt16">经翻译，实为</view>
      <view class="sub mt8" style="color: #1A1918;">{{v.herMeaning}}</view>
    </view>
    <view wx:if="{{v.hisWord}}" class="card mt24">
      <view class="faint">后应诉的那位说</view>
      <view style="font-size: 30rpx; font-weight: 500;" class="mt8">{{v.hisWord}}</view>
      <view class="faint mt16">经翻译，实为</view>
      <view class="sub mt8" style="color: #1A1918;">{{v.hisMeaning}}</view>
    </view>
    <view class="faint center mt16">两片证词，拼成同一件事的全貌</view>
  </view>

  <view wx:if="{{v.herNeed || v.hisNeed}}" class="reveal mt48" style="animation-delay: 1.15s">
    <text class="kicker">你们各自要的是什么</text>
    <view wx:if="{{v.herNeed}}" class="card mt16">
      <view class="faint">先开口的那位</view>
      <view class="sub mt8" style="color: #1A1918;">{{v.herNeed}}</view>
    </view>
    <view wx:if="{{v.hisNeed}}" class="card mt24">
      <view class="faint">后应诉的那位</view>
      <view class="sub mt8" style="color: #1A1918;">{{v.hisNeed}}</view>
    </view>
  </view>

  <view wx:if="{{v.loop}}" class="reveal mt48" style="animation-delay: 1.3s">
    <text class="kicker">你们正在转的圈</text>
    <view class="card mt16" style="border-left: 6rpx solid #B0793F;">
      <view class="sub" style="color: #1A1918;">{{v.loop}}</view>
      <view class="faint mt8">这个圈没有谁先动手，两个人都在里面。</view>
    </view>
  </view>

  <view wx:if="{{v.boundary}}" class="reveal mt48" style="animation-delay: 1.45s">
    <text class="kicker">这件事的边界</text>
    <view class="card mt16"><view class="sub" style="color: #1A1918;">{{v.boundary}}</view></view>
  </view>

  <view class="reveal mt48" style="animation-delay: 1.6s">
    <text class="kicker">误会指数</text>
    <view class="card mt16 col" style="align-items: center; padding: 48rpx 40rpx;">
      <view class="row" style="align-items: baseline; gap: 12rpx;">
        <text style="font-size: 96rpx; font-weight: 300; line-height: 1; color: #C9573F;">{{v.index}}</text>
        <text style="font-size: 32rpx; font-weight: 300; color: #C9573F;">%</text>
      </view>
      <text class="faint mt8">是误会，不是不爱</text>
      <view class="mt24" style="width: 100%; height: 8rpx; border-radius: 999rpx; background: rgba(201, 87, 63, 0.12); overflow: hidden;">
        <view style="width: {{v.index}}%; height: 8rpx; border-radius: 999rpx; background: #C9573F;"></view>
      </view>
      <view wx:if="{{v.residue}}" class="sub mt16 center" style="color: #1A1918;">{{v.residue}}</view>
      <view wx:else class="faint mt16">实际矛盾含量仅 {{100 - v.index}}% · 你们的问题，没那么大</view>
    </view>
  </view>

  <view class="reveal mt48" style="animation-delay: 2.1s">
    <text class="kicker">本庭判决</text>
    <view class="card mt16" style="position: relative; padding: 48rpx 40rpx;">
      <view class="faint">经本庭审理查明：</view>
      <view style="font-size: 36rpx; font-weight: 500; line-height: 1.6;" class="mt16">{{v.verdictTitle}}</view>
      <view class="sub mt16" style="color: #1A1918;">{{v.ruling}}</view>
      <view wx:if="{{sealed}}" class="seal seal-drop" style="position: absolute; top: -30rpx; right: 24rpx;">
        <text>{{seal.top}}</text><text>{{seal.bottom}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{hasSteps}}" class="reveal mt48" style="animation-delay: 2.7s">
    <text class="kicker">和解执行令</text>
    <view wx:if="{{v.herStep}}" class="card mt16 row" style="gap: 24rpx;">
      <view class="col grow">
        <view class="faint">先开口的那位 · 可以这样说</view>
        <view class="sub mt8" style="color: #1A1918;">{{v.herStep}}</view>
      </view>
      <view class="pill pill-honey qa-verdict-copy" bindtap="copyStep" data-text="{{v.herStep}}">复制</view>
    </view>
    <view wx:if="{{v.hisStep}}" class="card mt24 row" style="gap: 24rpx;">
      <view class="col grow">
        <view class="faint">后应诉的那位 · 可以这样说</view>
        <view class="sub mt8" style="color: #1A1918;">{{v.hisStep}}</view>
      </view>
      <view class="pill pill-honey qa-verdict-copy" bindtap="copyStep" data-text="{{v.hisStep}}">复制</view>
    </view>
  </view>

  <view wx:if="{{hasGuide}}" class="reveal mt48" style="animation-delay: 2.5s">
    <text class="kicker">具体可以怎么做</text>
    <view wx:if="{{v.herGuide.length}}" class="card mt16">
      <view class="faint">先开口的那位</view>
      <view wx:for="{{v.herGuide}}" wx:key="index" class="row mt16" style="gap: 16rpx; align-items: flex-start;">
        <text style="color: #B0793F; flex-shrink: 0;">·</text>
        <view class="sub grow" style="color: #1A1918;">{{item}}</view>
      </view>
    </view>
    <view wx:if="{{v.hisGuide.length}}" class="card mt24">
      <view class="faint">后应诉的那位</view>
      <view wx:for="{{v.hisGuide}}" wx:key="index" class="row mt16" style="gap: 16rpx; align-items: flex-start;">
        <text style="color: #B0793F; flex-shrink: 0;">·</text>
        <view class="sub grow" style="color: #1A1918;">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="reveal mt64 col action-stack" style="animation-delay: 2.95s;">
    <view class="btn btn-primary qa-verdict-pact" bindtap="goPact">落成本庭约定</view>
    <view class="btn btn-ghost qa-verdict-save" bindtap="saveImage">存成长图 · 分享此案</view>
    <view class="center mt16">
      <text class="faint qa-verdict-supplement" bindtap="supplement">判得不对？我还有话要补充 →</text>
    </view>
    <view class="faint center qa-verdict-privacy">分享卡片只含判决金句，不含任何隐私</view>
    <view class="center mt16"><text class="faint qa-verdict-history" bindtap="goHistory">回卷宗查看</text></view>
  </view>

</view>
