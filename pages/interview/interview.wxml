<view class="interview-page">

  <!-- 常驻保密提示：背对背的信任全靠这一条 -->
  <view class="row interview-header">
    <text class="pill pill-honey">对 TA 保密</text>
    <text class="faint grow">这段对话 TA 永远看不到</text>
    <text wx:if="{{!loading && !done}}" class="faint">{{asked}}/3</text>
  </view>

  <scroll-view scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation class="interview-scroll">

    <view wx:if="{{loading}}" class="col qa-interview-loading" style="align-items: center; padding-top: 120rpx;">
      <cat mood="calm" breathe="{{true}}" />
      <view class="faint mt32">{{mode === 'supplement' ? '判官正在重读这桩案子…' : '判官正在读你的陈述，想一句该问的话…'}}</view>
    </view>

    <view wx:elif="{{error}}" class="card state-card qa-interview-error">
      <view class="sub">{{error}}</view>
      <view class="btn btn-ghost mt24 qa-interview-retry" bindtap="retryTurn">重试这一轮</view>
    </view>

    <block wx:else>
      <view class="faint" style="text-align: center; padding-bottom: 8rpx;">
        {{mode === 'supplement' ? '说说哪里没说到，本庭重新审一次' : '本庭想再跟你聊几句，问完就开庭'}}
      </view>

      <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="qa-interview-message"
        style="display: flex; margin-top: 32rpx; justify-content: {{item.who === 'judge' ? 'flex-start' : 'flex-end'}};">

        <!-- 判官 -->
        <view wx:if="{{item.who === 'judge'}}" style="display: flex; gap: 16rpx; max-width: 86%; align-items: flex-start;">
          <view class="cf-face">
          <view class="cf-ear cf-ear-l"></view>
          <view class="cf-ear cf-ear-r"></view>
          <view class="cf-head">
            <view class="cf-eye cf-eye-l cf-blink"></view>
            <view class="cf-eye cf-eye-r cf-blink"></view>
            <view class="cf-mouth"></view>
          </view>
        </view>
          <view style="background: #FFFFFF; border: 1rpx solid #E1DACE; border-radius: 8rpx 28rpx 28rpx 28rpx; padding: 26rpx 30rpx;">
            <text style="font-size: 28rpx; line-height: 1.75; color: #1A1918;">{{item.text}}</text>
          </view>
        </view>

        <!-- 我 -->
        <view wx:else style="max-width: 78%; padding: 24rpx 30rpx; border-radius: 28rpx 8rpx 28rpx 28rpx; background: {{item.skipped ? '#F0EBE3' : '#B0793F'}};">
          <text style="font-size: 28rpx; line-height: 1.75; color: {{item.skipped ? '#9C958A' : '#FAF7F2'}};">{{item.text}}</text>
        </view>
      </view>

      <!-- 判官正在想 -->
      <view wx:if="{{thinking}}" style="display: flex; margin-top: 32rpx; gap: 16rpx; align-items: flex-start;">
        <view class="cf-face cf-tilt">
          <view class="cf-ear cf-ear-l"></view>
          <view class="cf-ear cf-ear-r"></view>
          <view class="cf-head">
            <view class="cf-eye cf-eye-l cf-blink"></view>
            <view class="cf-eye cf-eye-r cf-blink"></view>
            <view class="cf-mouth"></view>
            <view class="cf-dots">
              <view class="cf-dot cf-d1"></view>
              <view class="cf-dot cf-d2"></view>
              <view class="cf-dot cf-d3"></view>
            </view>
          </view>
        </view>
        <view class="breathe" style="background: #FFFFFF; border: 1rpx solid #E1DACE; border-radius: 8rpx 28rpx 28rpx 28rpx; padding: 26rpx 30rpx;">
          <text class="faint">判官正在想…</text>
        </view>
      </view>

      <view wx:if="{{done}}" class="interview-done">
        <view class="btn btn-primary qa-interview-trial" bindtap="toTrial">{{mode === 'supplement' ? '请求重审' : '请求开庭'}}</view>
      </view>

      <view style="height: 48rpx;"></view>
    </block>
  </scroll-view>

  <!-- 输入区 -->
  <view wx:if="{{!loading && !done && !error}}" class="interview-input-bar">
    <view style="white-space: nowrap; overflow-x: auto;">
      <text wx:for="{{chips}}" wx:key="index" class="chip" data-text="{{item}}" bindtap="pickChip">{{item}}</text>
    </view>

    <view class="row mt8 input-row">
      <input class="grow qa-interview-answer" value="{{input}}" bindinput="onInput" bindconfirm="send"
        placeholder="{{thinking ? '判官正在想…' : '说说看，几个字也行'}}" placeholder-class="field-ph" confirm-type="send"
        style="background: #FFFFFF; border: 1rpx solid #E1DACE; border-radius: 999rpx; padding: 20rpx 32rpx; font-size: 28rpx;" />
      <view bindtap="send" class="send-button qa-interview-send">发送</view>
    </view>

    <view class="row mt16" style="gap: 24rpx;">
      <view class="grow voice-button qa-interview-voice {{recording ? 'voice-recording' : ''}}" bindtouchstart="recStart" bindtouchend="recEnd" bindtouchcancel="recEnd">
        {{transcribing ? '正在听写…' : (recording ? '松开结束' : '🎙 按住说话')}}
      </view>
      <view bindtap="skip" class="skip-button qa-interview-skip">这个先不说</view>
    </view>
  </view>

</view>
