.interview-page { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; background: #FFF9F1; }
.interview-header { gap: 12rpx; padding: 20rpx 50rpx; border-bottom: 1rpx solid #E8D9C8; }
.interview-scroll { flex: 1; padding: 32rpx 50rpx; box-sizing: border-box; }
.state-card { background: #FFFDF9; }
.interview-done { display: flex; justify-content: center; margin-top: 56rpx; }
.interview-input-bar { border-top: 1rpx solid #E8D9C8; padding: 20rpx 50rpx 36rpx; }
.input-row { gap: 16rpx; }
.send-button { flex-shrink: 0; width: 96rpx; height: 76rpx; border-radius: 999rpx; background: #2B2118; color: #FFF9F1; display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.voice-button { height: 72rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; background: #FFFDF9; color: #806F60; border: 1rpx solid #E8D9C8; }
.voice-recording { background: #B0793F; color: #FFF9F1; border-color: #B0793F; }
.skip-button { flex-shrink: 0; height: 72rpx; padding: 0 32rpx; border-radius: 999rpx; display: flex; align-items: center; font-size: 24rpx; color: #A79686; }
