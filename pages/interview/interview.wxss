.interview-page { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; background: #FAF7F2; }
.interview-header { gap: 12rpx; padding: calc(20rpx + env(safe-area-inset-top)) 50rpx 20rpx; border-bottom: 1rpx solid #E1DACE; }
.interview-scroll { flex: 1; padding: 32rpx 50rpx; box-sizing: border-box; }
.state-card { background: #FFFDF9; }
.interview-done { display: flex; justify-content: center; margin: 56rpx 0 24rpx; }
.interview-done .btn { width: 100%; box-sizing: border-box; }
.interview-input-bar { border-top: 1rpx solid #E1DACE; padding: 20rpx 50rpx calc(36rpx + env(safe-area-inset-bottom)); }
.input-row { gap: 16rpx; }
.send-button { flex-shrink: 0; width: 96rpx; height: 76rpx; border-radius: 999rpx; background: #3B2919; color: #FAF7F2; display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.voice-button { height: 72rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; background: #FFFDF9; color: #6E685F; border: 1rpx solid #E1DACE; }
.voice-recording { background: #B0793F; color: #FAF7F2; border-color: #B0793F; }
.skip-button { flex-shrink: 0; height: 72rpx; padding: 0 32rpx; border-radius: 999rpx; display: flex; align-items: center; font-size: 24rpx; color: #A79686; }
