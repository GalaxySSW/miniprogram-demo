.accept-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 50rpx 60rpx; }
.accept-header { justify-content: space-between; min-height: 44rpx; }
.accept-case-card { position: relative; padding: 44rpx 40rpx; }
